# Reference template only. Never commit working credentials.
# Fresh setup: uv run python scripts/setup_env.py
# Existing setup: keep the migrated .env and its database password unchanged.
POSTGRES_DB=fracture_clinic
POSTGRES_USER=clinic_owner
POSTGRES_PASSWORD=
DB_HOST=127.0.0.1
# Keep your existing port, e.g. 5433, when migrating an existing installation.
DB_PORT=5432

# Provider configuration. Defaults can be inspected without an API key.
# Do not copy this file over an existing .env; add only the settings you need.
OPENAI_API_KEY=

STT_PROVIDER=openai
STT_MODEL=gpt-live-transcribe
STT_BASE_URL=wss://api.openai.com/v1/realtime
# English-only. The gpt-live adapter sends languages=["en"], not legacy language.
STT_LANGUAGE=en
# Close-handshake timeout only, not connect time or end-of-turn latency.
STT_WS_CLOSE_TIMEOUT_SECONDS=2
# Mark safely ordered completed audio as final to avoid the unnecessary STT wait.
# Set false to restore the stock Pipecat path for a controlled comparison.
STT_FINALIZE_TRANSCRIPTS=true

LLM_PROVIDER=openai
LLM_MODEL=gpt-4.1-mini-2025-04-14
LLM_BASE_URL=https://api.openai.com/v1
LLM_TIMEOUT_SECONDS=30
LLM_CONNECT_TIMEOUT_SECONDS=5
# Retain idle pooled HTTP connections for reuse; not a request timeout or ping.
# Set 5 for the previous SDK baseline; restart after changing.
LLM_KEEPALIVE_EXPIRY_SECONDS=60
LLM_MAX_OUTPUT_TOKENS=512

TTS_PROVIDER=openai
TTS_MODEL=gpt-4o-mini-tts
TTS_BASE_URL=https://api.openai.com/v1
TTS_VOICE=coral
# Default delivery instructions are defined in config.py and recorded in each run.
# Override with style-only text if needed; never put credentials or patient data here.
# Set to off (or an empty value) to reproduce the previous no-instructions baseline.
# TTS_INSTRUCTIONS=off
# Restart the server after changing TTS settings; reconnect alone does not reload them.
TTS_TIMEOUT_SECONDS=30
TTS_CONNECT_TIMEOUT_SECONDS=5
TTS_KEEPALIVE_EXPIRY_SECONDS=60
# PCM read chunk duration, not speaking speed or text segmentation (20–1000 ms).
# Use 500 for the previous buffering baseline; restart after changing.
TTS_AUDIO_CHUNK_MS=100

# Set true when you are ready to test with your private API key.
LIVE_API_ENABLED=false

# Local browser runtime. Fixed loopback host: 127.0.0.1. No public deployment.
VOICE_PORT=7860
# Continuous-silence fallback when Smart Turn has not detected completion.
# Shorter waits can cut off thinking pauses. Use 3 for the previous baseline.
VOICE_SMART_TURN_STOP_SECONDS=1.5
# 'none' disables automatic idle/session cutoffs.
VOICE_IDLE_TIMEOUT_SECONDS=none
VOICE_MAX_SESSION_SECONDS=none
VOICE_SETUP_TIMEOUT_SECONDS=20
VOICE_START_TIMEOUT_SECONDS=20
VOICE_CANCEL_TIMEOUT_SECONDS=10
# Input: 16 kHz mono PCM; output: 24 kHz mono PCM, transported over WebRTC.
# Do not enable PIPECAT_SMART_TURN_LOG_DATA; hidden WAV logging is rejected.

# Optional paired local speech experiment (Mac Apple Silicon):
# ./scripts/voice_local.sh --prepare-local-models   # public model downloads only
# ./scripts/voice_local.sh --check-config          # no model loading/API calls
# ./scripts/voice_local.sh                        # local ASR/TTS + OpenAI LLM
# The script overrides models/endpoints/voices without editing your private .env.
# STT_PROVIDER=whisper; STT_MODEL=mlx-community/whisper-large-v3-turbo
# TTS_PROVIDER=kokoro; TTS_MODEL=kokoro-v1.0; TTS_INSTRUCTIONS=off
# Local providers must have unset/empty STT_BASE_URL and TTS_BASE_URL.
# Local-only optional settings (these defaults are recorded even when inactive):
# STT_MAX_SEGMENT_SECONDS=60
# STT_MAX_PENDING_SEGMENTS=8
# STT_INFERENCE_TIMEOUT_SECONDS=30
# STT_REUSE_ENCODER=true     # false restores stock mlx-whisper transcription
# TTS_CPU_THREADS=2          # default unchanged pending measured 2-vs-4 comparison
# TTS_FIRST_CHUNK_CHARS=60   # first request only; 0 restores whole-request synthesis
# TTS_LANGUAGE=en             # English-only local experiment
# TTS_VOICE=af_heart          # English Kokoro voice
# TTS_HINDI_VOICE=hf_alpha
# TTS_SPEED=1.0
# TTS_INFERENCE_TIMEOUT_SECONDS=30

# Optional self-hosted GPU stack. See docs/gpu-models.md for pinned server setup.
# No dependencies/models are installed by this launcher and it does not edit .env.
# ./scripts/voice_gpu.sh --check-config
# LIVE_API_ENABLED=true ./scripts/voice_gpu.sh
# All three self-hosted stages need no OPENAI_API_KEY. Mixed OpenAI stages do.
# STT_PROVIDER=nemotron
# STT_MODEL=nemotron-3.5-asr-streaming-0.6b
# STT_BASE_URL=ws://127.0.0.1:8080/v1/audio/transcriptions/realtime
# STT_LANGUAGE=auto         # explicit NeMo locale may also be supplied
# LLM_PROVIDER=hybrid_diffusion
# LLM_MODEL=yuchen-zhu-zyc/HybridDiffusion-2B
# LLM_BASE_URL=http://127.0.0.1:30000/v1
# TTS_PROVIDER=breeze
# TTS_MODEL=BreezeBlue/Breeze-TTS-2
# TTS_BASE_URL=http://127.0.0.1:7861  # root, not /v1
# TTS_VOICE=S0
# TTS_INSTRUCTIONS=A warm, calm conversational voice.
# TTS_LANGUAGE=auto         # Breeze infers English/Chinese from text; not Hindi
# TTS_BREEZE_CFG_SCALE=4
# Separate optional Bearer keys for self-hosted endpoints; never OpenAI key reuse.
# STT_API_KEY=
# LLM_API_KEY=
# TTS_API_KEY=
# Use SSH tunnels to remote GPU loopback ports, or HTTPS/WSS behind auth.
# Kokoro chunk splitting/CPU settings and Whisper encoder reuse do not affect these providers.

# Optional clinician profile. Keep existing database settings above.
# Launched by scripts/voice_clinician.sh; front-desk profile is unaffected.
# No preselected case; select it in conversation with open_case.
# CLINICIAN_USER_ID=SYN-USER-CLIN
# EXA_API_KEY=
# EXA_SEARCH_DOMAINS=nhs.uk,nice.org.uk,orthoinfo.aaos.org
# Demo only: delay the first valid web search per clinician session, once.
# 0 disables; allowed range 0..15 seconds. Other searches/tools remain undelayed.
# CLINICIAN_DEMO_WEB_SEARCH_DELAY_SECONDS=0
